# Environment variables for Virtual Grünfeld.
# Copy to .env and fill in. Full reference, including deployment: DEPLOYMENT.md.

# ── Required ──
OPENAI_API_KEY=your_openai_api_key_here
# Without this the teacher still writes, but never speaks.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Server ──
PORT=3002
NODE_ENV=development
# Browser origins allowed to call this server, comma-separated. Unset means
# localhost on any port and nothing else — which is what you want locally.
# TEACHER_CORS_ORIGIN=https://play.welte225.org

# ── The teacher ──
OUTPUT_LANGUAGE=German
# Where per-session take history is written (gitignored; defaults to ./data/sessions)
SESSIONS_DIR=data/sessions
# Model for the student-profile side-channel (runs after the teacher has answered)
OPENAI_PROFILE_MODEL=gpt-5.4-mini
# Tier -> model. Defaults are measured, not guessed (see src/config.ts).
# OPENAI_CUE_MODEL_REALTIME=gpt-5.4-mini
# OPENAI_CUE_MODEL_BALANCED=gpt-5.6-terra
# OPENAI_CUE_MODEL_STUDIO=gpt-5.6-terra

# ── Voice ──
# ELEVENLABS_VOICE_ID=a4oYSRgmiY0auDgVfso5
# Spoken questions. The language follows OUTPUT_LANGUAGE unless set here.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_TRANSCRIBE_LANGUAGE=de
# The take path needs eleven_v3 for character timestamps — changing this breaks
# cue scheduling over live playback.
# ELEVENLABS_MODEL_ID=eleven_v3
# The answer path has no timestamps to slice, so it defaults to a 15x faster
# model. Set to eleven_v3 to trade ~9s per answer for a warmer delivery.
# ELEVENLABS_ASK_MODEL_ID=eleven_turbo_v2_5

# ── Offline test script only (generate_test.ts) ──
# SF2_PATH=/path/to/soundfont.sf2
