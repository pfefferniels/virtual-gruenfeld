# Environment variables for Virtual Grünfeld
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
MEICO_BIN=/usr/local/bin/meicoApp
MPM_MOD_BIN=/usr/local/bin/mpm-modifier
RENDER_AUDIO_FORMAT=mp3
RENDER_MAX_SECONDS=60
PORT=3001
NODE_ENV=development
OUTPUT_LANGUAGE=German
# Model for the student-profile side-channel (runs after the teacher has answered)
OPENAI_PROFILE_MODEL=gpt-5.4-mini
# Where per-session take history is written (gitignored; defaults to ./data/sessions)
SESSIONS_DIR=data/sessions