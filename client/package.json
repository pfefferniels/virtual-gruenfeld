{
  "name": "virtual-gruenfeld-client",
  "version": "1.0.0",
  "description": "React frontend for Virtual Grünfeld application",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fix-vite-crypto.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/fix-vite-crypto.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node scripts/fix-vite-crypto.mjs && vitest"
  },
  "dependencies": {
    "midifile-ts": "^1.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tonejs/piano": "^0.3.0",
    "tone": "^14.7.77",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^3.2.4"
  },
  "keywords": [
