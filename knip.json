{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [
    "espressivo"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/plan/index.ts",
        "src/jev/index.ts",
        "*.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts",
        "scripts/*.ts"
      ]
    },
    "client": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
