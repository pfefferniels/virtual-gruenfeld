{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["mpm-ts", "mpmify"],
  "ignoreBinaries": ["java"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts", "*.ts"]
    },
    "client": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
