{
  "name": "virtual-gruenfeld",
  "version": "1.0.0",
  "description": "AI web app for conversing with Alfred Grünfeld's historical piano rendition",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --ignore ./renders --watch ./src --exec tsx src/server.ts",
    "client:dev": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "music",
    "ai",
    "piano",
    "historical",
    "performance"
  ],
  "author": "Virtual Grünfeld Project",
  "license": "MIT",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.21.0",
    "@openai/agents": "^0.1.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^27.0.0",
    "@types/multer": "^1.4.11",
    "@xmldom/xmldom": "^0.8.11",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "doubtful": "file:../doubtful",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.2.5",
    "fontoxpath": "^3.33.2",
    "jsdom": "^27.0.1",
    "mpm-ts": "file:../mpm-ts",
    "mpmify": "file:../mpmify",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.7.0",
    "query-selector": "^2.0.0",
    "roughjs": "^4.6.6",
    "uuid": "^13.0.0",
    "verovio": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
