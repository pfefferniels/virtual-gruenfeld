{
  "name": "virtual-gruenfeld",
  "version": "1.0.0",
  "description": "AI web app for conversing with Alfred Grünfeld's historical piano rendition",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "java:dev": "java -jar ~/Projects/mpm-renderer/server/build/libs/server-all.jar",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --ignore ./renders --watch ./src --exec tsx src/server.ts",
    "client:dev": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "knip": "knip"
  },
  "keywords": [
    "music",
    "ai",
    "piano",
    "historical",
    "performance"
  ],
  "author": "Virtual Grünfeld Project",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mpm-ts": "file:../mpm-ts",
    "mpmify": "file:../mpmify",
    "openai": "^6.7.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "concurrently": "^8.2.2",
    "knip": "^5.85.0",
    "midifile-ts": "^1.5.2",
    "nodemon": "^3.0.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
